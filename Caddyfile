{
	# Railway terminates TLS and proxies to $PORT.
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	# Health check for Railway (set the service's healthcheck path to /health).
	respond /health 200

	root * /srv/dist
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
		-Server
	}

	# Vite fingerprints everything in /assets: cache it for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Images keep their names when replaced: cache a week.
	@images path /img/*
	header @images Cache-Control "public, max-age=604800"

	# The page itself is always revalidated so new deploys show up at once.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
